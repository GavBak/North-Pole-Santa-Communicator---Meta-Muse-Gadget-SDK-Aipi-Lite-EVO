# OS
.DS_Store
Thumbs.db

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# Python
__pycache__/
*.pyc
*.pyo
.venv/
build/

# Claude Code: local settings stay out; the shared skills are tracked
!.claude/
.claude/*
!.claude/skills/
# Interactive simulator screenshot.
muse-simulator.ppm

# Local gadget provisioning and original-device flash backups.
.sdk-token
/backups/

# Secrets: SDK token and API keys live here, one per file (secrets/README.md)
secrets/*
!secrets/README.md
!secrets/*.example

# Build output carries the secrets inside its sdkconfig
build-*/

# North Pole Santa Communicator: never publish secrets or firmware images
build*/
sdkconfig
sdkconfig.old
*.bin
*.elf
*.tar.gz
*.zip
*.log
design/*.ttf
# Wake-word weights stay local. Place hey_santa.tflite in
# esp32/components/muse/wake/ and rebuild; the firmware leaves the word off
# until that file is there.
esp32/components/muse/wake/*.tflite
# Clips from tools/npsc/pull_clips.py are children's voices.
*.wav
