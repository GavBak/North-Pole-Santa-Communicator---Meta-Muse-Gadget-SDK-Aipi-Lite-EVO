# AIPI Lite: ESP32-S3R8 (8 MB octal PSRAM), 16 MB flash, two buttons, no touch.
# Load last, after sdkconfig.muse.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_MUSE_BOARD_AIPI=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Static buffers in PSRAM: Wi-Fi's, lwIP's and BT's, and those marked
# EXT_RAM_BSS_ATTR (Muse's chat turn, the tunnel batch). Without it free
# internal RAM falls to 6 KB pieces and BLE setup can't start its 8 KB task.
# The chip always has PSRAM, so booting without it needn't be allowed.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set
# That forces Wi-Fi's TX buffers static, in internal RAM: 8, not 16, at 1.6 KB
# each, which voice over the tunnel doesn't fill.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
# Two-button menu.
CONFIG_LV_FONT_MONTSERRAT_12=y

# Screen off on battery: the CPU drops to the crystal clock and light-sleeps
# between button polls (muse_input.c). BLE has to allow that with modem sleep;
# there's no 32 kHz crystal, so its sleep clock is the main crystal, kept
# powered. On USB power the chip stays awake at full speed.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
# The CPU stays powered in light sleep: saving its state takes 8.5 KB of
# internal RAM, more than Wi-Fi can spare here.
# CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP is not set
# Pins keep their state in light sleep. This workaround would float them all,
# panel and touch reset and the amp enable included.
# CONFIG_ESP_SLEEP_GPIO_RESET_WORKAROUND is not set
# For the battery meter (muse_battery.h, ">power" on the console): time
# actually slept, and how long each power lock kept the chip awake.
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y
CONFIG_PM_PROFILING=y

# --- Santa build additions (ElevenLabs spoken replies) ---
# Model pinned explicitly (also the Kconfig default). The voice ID is NOT
# set here: it comes from secrets/elevenlabs_voice_id, injected into the
# generated sdkconfig at build time by esp32/tools/muse/secrets.py.
CONFIG_MUSE_ELEVENLABS_MODEL="eleven_flash_v2_5"
# api.elevenlabs.io presents a GTS Root R1 chain cross-signed by GlobalSign;
# without this the TLS verify against the stock cert bundle can fail
# (the fork sets the same flag in its Waveshare device overlays).
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
# CONFIG_MUSE_ELEVENLABS_API_KEY is deliberately NOT set here. It stays
# empty (= spoken replies off) until Gav creates secrets/elevenlabs_api_key
# with his own key; secrets.py injects it at build time.

# NORTH POLE / SANTA COMMUNICATOR screen: components/muse/avatar/muse_pixel.c
# (gitignored, with npsc_art.h) is a full-screen 128x128 picture rather than a
# character, so the canvas fills the panel and no hint icons or status line
# are drawn over it. Remove this line along with that avatar/ folder to go
# back to the default avatar.
CONFIG_MUSE_FULLSCREEN_ART=y

# Talk button (bottom right) toggles: click to start talking, click again to
# send. Releases don't count; a note still stops on its own after 15 s.
CONFIG_MUSE_TALK_TOGGLE=y

# Menu button (bottom left): a single press only wakes the screen, a double
# press opens the menu, four presses toggle phone setup (Bluetooth pairing);
# with the extras below, three start story time and five play the jingle.
CONFIG_MUSE_MENU_DOUBLE_PRESS=y
# North Pole Santa Communicator extras (components/muse/Kconfig, muse_npsc.c):
# sleeps count under the art, wake splash, story time (3 presses of MENU),
# Elf on Duty at bedtime, Christmas Eve sleigh tracker (simulated), jingle
# (5 presses of MENU), kid's name + wake greeting.
CONFIG_MUSE_NPSC_COUNTDOWN=y
CONFIG_MUSE_NPSC_WAKE_SPLASH=y
CONFIG_MUSE_NPSC_STORY=y
CONFIG_MUSE_NPSC_ELF=y
CONFIG_MUSE_NPSC_TRACKER=y
CONFIG_MUSE_NPSC_JINGLE=y
CONFIG_MUSE_NPSC_PARENT=y
CONFIG_MUSE_NPSC_BOOT_SHOW_MS=5000
# Greeting and Santa's stories use this until a name is picked in the menu
# (build tree only; the public fork leaves it empty).
CONFIG_MUSE_NPSC_KID_NAME_DEFAULT=""

# "Hey Santa" wake word. The weights are not in git: put
# components/muse/wake/hey_santa.tflite in place (gitignored) and rebuild.
# Without that file this stays on and the word stays off.
CONFIG_MUSE_WAKE_WORD=y
CONFIG_MUSE_NPSC_WAKE_RECORD=y
CONFIG_MUSE_ELEVENLABS_LANGUAGE="en"
